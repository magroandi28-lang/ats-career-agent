# Backend / Render
APP_ENV=development
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
ALLOWED_ORIGINS=http://localhost:3000,https://ats-career-agent-z3od.vercel.app

# Biztonsági limitek
MAX_JSON_BYTES=2097152
MAX_UPLOAD_BYTES=5242880
API_REQUESTS_PER_MINUTE=60
AI_REQUESTS_PER_MINUTE=12
AUTH_REQUESTS_PER_MINUTE=8

# Külső szolgáltatások — kizárólag a backend környezetében
AI_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_FLOW_MODEL=gemini-2.5-flash
OPENAI_FLOW_MODEL=gpt-5.6-terra
GEMINI_ADVISOR_MODEL=gemini-2.5-pro
OPENAI_ADVISOR_MODEL=gpt-5.6
GEMINI_WRITER_MODEL=gemini-2.5-pro
OPENAI_WRITER_MODEL=gpt-5.6
AI_TIMEOUT_SECONDS=90
AI_MAX_STEPS_PER_RUN=8
AI_MAX_TOOL_CALLS_PER_RUN=5
SERPAPI_KEY=
JOOBLE_API_KEY=
